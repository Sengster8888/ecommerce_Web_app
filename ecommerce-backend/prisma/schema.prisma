// This is your Prisma schema file for the E-Commerce System Web App (Cambodia)
// It maps the core tables of the system using PostgreSQL-flavored types,
// proper relational foreign keys, cascades, indices, and Decimal money representation.
// Version 2: Added refreshTokenHash for secure JWT rotation and OtpVerification for email-based MFA.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 1. USERS MODEL
/// Stores customers and admins under unified authentication.
model User {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @db.VarChar(150)
  email            String   @unique @db.VarChar(255)
  phone            String?  @db.VarChar(20)
  avatarUrl        String?  @map("avatar_url") @db.VarChar(500)
  passwordHash     String?  @map("password_hash") @db.VarChar(255)
  refreshTokenHash String?  @map("refresh_token_hash") @db.VarChar(255) // Added for secure JWT rotation
  isEmailVerified  Boolean  @default(false) @map("is_email_verified")   // Added to track OTP verification state
  role             String   @db.VarChar(20) // 'customer' or 'admin'
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp

  addresses     Address[]
  carts         Cart?
  orders        Order[]
  orderTracking OrderTracking[]
  reviews       Review[]

  @@map("users")
}

/// 2. CATEGORIES MODEL
/// For grouping and filtering catalog items. Supports optional subcategories.
model Category {
  id               BigInt     @id @default(autoincrement()) @db.BigInt
  name             String     @db.VarChar(100)
  slug             String     @unique @db.VarChar(120)
  imageUrl         String?    @map("image_url") @db.VarChar(500)
  parentCategoryId BigInt?    @map("parent_category_id") @db.BigInt
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamp
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamp

  parent           Category?  @relation("CategoryToCategory", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subCategories    Category[] @relation("CategoryToCategory")
  products         Product[]
  discountCategories DiscountCategory[]

  @@map("categories")
}

/// 3. PRODUCTS MODEL
/// Catalog of products with stock check and precise pricing.
model Product {
  id          BigInt         @id @default(autoincrement()) @db.BigInt
  categoryId  BigInt         @map("category_id") @db.BigInt
  name        String         @db.VarChar(200)
  slug        String         @unique @db.VarChar(220)
  description String         @db.Text
  price       Decimal        @db.Decimal(12, 2) // Prevents floating-point rounding errors
  stock       Int            @db.Integer
  status      String         @db.VarChar(20) // 'active', 'inactive', 'out_of_stock'
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamp

  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  discountProducts DiscountProduct[]

  @@map("products")
}

/// 4. PRODUCT IMAGES MODEL
/// Image gallery for catalog products.
model ProductImage {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  productId BigInt   @map("product_id") @db.BigInt
  imageUrl  String   @map("image_url") @db.VarChar(500)
  isPrimary Boolean  @default(false) @map("is_primary") @db.Boolean
  sortOrder Int      @default(0) @map("sort_order") @db.Integer
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

/// 5. ADDRESSES MODEL
/// Customer delivery addresses.
model Address {
  id            BigInt   @id @default(autoincrement()) @db.BigInt
  userId        String   @map("user_id") @db.Uuid
  label         String   @db.VarChar(50) // e.g., 'Home', 'Office'
  recipientName String   @map("recipient_name") @db.VarChar(150)
  phone         String   @db.VarChar(20)
  province      String   @db.VarChar(100) // Cambodian Address Component
  city          String   @db.VarChar(100) // Cambodian Address Component
  commune       String   @db.VarChar(100) // Cambodian Address Component
  streetLine    String   @map("street_line") @db.VarChar(255)
  isDefault     Boolean  @default(false) @map("is_default") @db.Boolean
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@map("addresses")
}

/// 6. CARTS MODEL
/// Standard shopping cart, 1 active per customer.
model Cart {
  id        BigInt     @id @default(autoincrement()) @db.BigInt
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamp

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

/// 7. CART ITEMS MODEL
/// List of items inside active shopping carts.
model CartItem {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  cartId    BigInt   @map("cart_id") @db.BigInt
  productId BigInt   @map("product_id") @db.BigInt
  quantity  Int      @db.Integer
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

/// 8. ORDERS MODEL
/// Relational orders table keeping status independent of payment status.
model Order {
  id              BigInt            @id @default(autoincrement()) @db.BigInt
  orderNumber     String            @unique @map("order_number") @db.VarChar(30) // ORD-YYYYMMDD-XXX
  userId          String            @map("user_id") @db.Uuid
  addressId       BigInt            @map("address_id") @db.BigInt
  status          String            @db.VarChar(20) // e.g., PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REJECTED
  subtotal        Decimal           @db.Decimal(12, 2)
  discountAmount  Decimal           @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  shippingFee     Decimal           @map("shipping_fee") @db.Decimal(12, 2)
  totalAmount     Decimal           @map("total_amount") @db.Decimal(12, 2)
  paymentMethod   String            @map("payment_method") @db.VarChar(20) // 'khqr' or 'cod'
  rejectionReason String?           @map("rejection_reason") @db.VarChar(255)
  discountId      BigInt?           @map("discount_id") @db.BigInt
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamp
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamp

  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  address         Address           @relation(fields: [addressId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  payments        Payment[]
  orderTracking   OrderTracking[]
  telegramMessages TelegramMessage[]
  discount        Discount?         @relation(fields: [discountId], references: [id], onDelete: SetNull)

  @@map("orders")
}

/// 9. ORDER ITEMS MODEL
/// Price snapshotting to preserve historical price integrity when prices update in products catalog.
model OrderItem {
  id                  BigInt   @id @default(autoincrement()) @db.BigInt
  orderId             BigInt   @map("order_id") @db.BigInt
  productId           BigInt   @map("product_id") @db.BigInt
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(200)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity            Int      @db.Integer
  lineTotal           Decimal  @map("line_total") @db.Decimal(12, 2)

  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

/// 10. PAYMENTS MODEL
/// Accommodates Cambodian local payments (KHQR/Bakong) and COD, storing status separately.
model Payment {
  id                BigInt    @id @default(autoincrement()) @db.BigInt
  orderId           BigInt    @map("order_id") @db.BigInt
  method            String    @db.VarChar(20) // 'khqr' or 'cod'
  status            String    @db.VarChar(20) // PENDING / PAID / FAILED / REFUNDED
  amount            Decimal   @db.Decimal(12, 2)
  providerReference String?   @map("provider_reference") @db.VarChar(100) // External Bank Transaction ID
  md5               String?   @db.VarChar(32) // Hash used by Bakong to identify and verify the transaction
  qrString          String?   @map("qr_string") @db.Text // Raw EMVCo payload string cached for reuse
  expiresAt         DateTime? @map("expires_at") @db.Timestamp // Time window indicating when the QR code invalidates
  paidAt            DateTime? @map("paid_at") @db.Timestamp
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp

  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@map("payments")
}

/// 11. ORDER TRACKING MODEL
/// Append-only audit history of every status shift.
model OrderTracking {
  id              BigInt   @id @default(autoincrement()) @db.BigInt
  orderId         BigInt   @map("order_id") @db.BigInt
  status          String   @db.VarChar(20)
  note            String?  @db.VarChar(255) // Stores reasons or courier notes
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid // Admin/user triggering transition
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser   User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@map("order_tracking")
}

/// 12. TELEGRAM MESSAGES MODEL
/// Audit logging of outbound order notifications and button actions.
model TelegramMessage {
  id                BigInt    @id @default(autoincrement()) @db.BigInt
  orderId           BigInt    @map("order_id") @db.BigInt
  telegramChatId    String    @map("telegram_chat_id") @db.VarChar(50)
  telegramMessageId String    @map("telegram_message_id") @db.VarChar(50)
  messageType       String    @map("message_type") @db.VarChar(30) // NEW_ORDER, ORDER_CONFIRMED, ORDER_REJECTED etc.
  status            String    @db.VarChar(20) // SENT, FAILED, PENDING_RETRY
  sentAt            DateTime? @map("sent_at") @db.Timestamp
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp

  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("telegram_messages")
}

/// 13. OTP VERIFICATIONS MODEL
/// Stores short-lived OTP codes sent via email for Registration verification, Login MFA, or Password Resets.
model OtpVerification {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  email     String   @db.VarChar(255)
  code      String   @db.VarChar(6) // 6-digit verification code
  purpose   String   @db.VarChar(30) // 'REGISTER_VERIFY', 'LOGIN_MFA', 'PASSWORD_RESET'
  payload   String?  @db.Text // Stores pending user registration payload (name, phone, passwordHash)
  expiresAt DateTime @map("expires_at") @db.Timestamp
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  @@index([email, code])
  @@map("otp_verifications")
}

/// 14. DISCOUNTS MODEL
/// Supports Store-Wide, Product/Category-Specific, and Checkout Promo Code discounts.
model Discount {
  id                  BigInt   @id @default(autoincrement()) @db.BigInt
  name                String   @db.VarChar(150)
  description         String?  @db.Text
  type                String   @db.VarChar(20) // 'PERCENTAGE' or 'FIXED_AMOUNT'
  scope               String   @db.VarChar(30) // 'ALL_PRODUCTS', 'SPECIFIC_PRODUCTS', 'CATEGORY', 'PROMO_CODE'
  value               Decimal  @db.Decimal(12, 2)
  maxDiscountAmount   Decimal? @map("max_discount_amount") @db.Decimal(12, 2)
  minimumOrderAmount  Decimal  @default(0.00) @map("minimum_order_amount") @db.Decimal(12, 2)
  code                String?  @unique @db.VarChar(50) // Nullable, populated when scope = 'PROMO_CODE'
  startDate           DateTime @map("start_date") @db.Timestamp
  endDate             DateTime @map("end_date") @db.Timestamp
  usageLimit          Int?     @map("usage_limit") @db.Integer
  usageCount          Int      @default(0) @map("usage_count") @db.Integer
  usageLimitPerUser   Int?     @map("usage_limit_per_user") @db.Integer
  isActive            Boolean  @default(true) @map("is_active") @db.Boolean
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamp

  discountProducts   DiscountProduct[]
  discountCategories DiscountCategory[]
  orders             Order[]

  @@map("discounts")
}

model DiscountProduct {
  discountId BigInt   @map("discount_id") @db.BigInt
  productId  BigInt   @map("product_id") @db.BigInt
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@map("discount_products")
}

model DiscountCategory {
  discountId BigInt   @map("discount_id") @db.BigInt
  categoryId BigInt   @map("category_id") @db.BigInt
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
  @@map("discount_categories")
}

/// 15. VERIFIED REVIEWS MODEL
/// Chronological 1-5 star ratings. Does not include optional comment texts to maintain thin data profiles.
model Review {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  productId BigInt   @map("product_id") @db.BigInt
  userId    String   @map("user_id") @db.Uuid
  rating    Int      @db.Integer // Must be strictly constrained (1 to 5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One customer can only submit one rating per product to prevent star-boosting exploits
  @@unique([userId, productId])
  @@map("reviews")
}
